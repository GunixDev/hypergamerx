{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".wrangler",
    "public"
  ],
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strictNullChecks": true,
    "incremental": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./*"],
      "@src/*": ["./src/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@pages/*": ["./src/pages/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@public/*": ["./public/*"],
    }
  }
}