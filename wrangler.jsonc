{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypergamerx",
  "main": "src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "1348047137e491260eacd427a7fdcc83",

  "placement": {
    "mode": "smart"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "74d7d08d-81da-48ff-b5df-81a2efa4efd0"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hypergamerx-media"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "7db7c926d27e4af6935aebffb85968aa"
    },
    {
      "binding": "CACHE",
      "id": "a5a50372e43d4d36b6651ffe35e909e3"
    }
  ],

  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "74d7d08d-81da-48ff-b5df-81a2efa4efd0"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "hypergamerx-media"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "7db7c926d27e4af6935aebffb85968aa"
        },
        {
          "binding": "CACHE",
          "id": "a5a50372e43d4d36b6651ffe35e909e3"
        }
      ]
    }
  },

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}