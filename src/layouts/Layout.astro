---
import "@fontsource/lato";
import "@fontsource-variable/assistant";
import MetaTags from "@components/layout/MetaTags.astro";
import { ClientRouter } from "astro:transitions";
import CookieConsent from "@components/layout/CookieConsent.astro";
import "@src/styles/global.css";
import Navigation from "@components/layout/Navigation.astro";
import Footer from "@components/layout/Footer.astro";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  autor?: string;
  type?: string;
  class?: string;
  robots?: string;
  pubDate?: string;
  updatedDate?: string;
}

const {
  class: className,
  title = "HyperGamerX: Tu Destino para Noticias de Videojuegos",
  description = "Descubre las últimas noticias y curiosidades en el mundo de los videojuegos. Reseñas, avances, análisis y más, HyperGamerX tu fuente de información.",
  image = "/img/logo4.png",
  imageAlt = "Logo de HyperGamerX",
  autor = "Brayan Cordova",
  type = "website",
  robots = "index, follow",
  pubDate,
  updatedDate,
} = Astro.props;
---

<html lang={"es"}>
  <head>
    <meta charset="UTF-8">
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-space-grotesk" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preload" as="image" href={image} />
    <meta name="publisuites-verify-code" content="aHR0cHM6Ly93d3cuaHlwZXJnYW1lcnguY29t" />
    <MetaTags title={title} description={description} image={image} imageAlt={imageAlt} autor={autor} type={type} pubDate={pubDate} updatedDate={updatedDate} robots={robots} />

    <script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-KW6PKZ3FV9"></script>

    <script>
      declare global {
        interface Window {
          dataLayer: Record<string, any>[];
          gtag: (...args: any[]) => void;
        }
      }

      document.addEventListener("astro:page-load", () => {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
        });
        window.gtag("config", "G-KW6PKZ3FV9");
      });
    </script>
  </head>

  <body class="bg-background text-foreground flex flex-col">
    <div transition:persist id="cc-container" class="cc--darkmode">
      <CookieConsent />
      <script is:inline>
        document.addEventListener("astro:before-preparation", (_event) => {
          const htmlClassName = window.document.documentElement.className;
          window._showConsentClass = htmlClassName.includes("show--consent");
        });
        document.addEventListener("astro:before-swap", (event) => {
          const showConsent = window._showConsentClass ? ` show--consent` : "";
          event.newDocument.documentElement.className += showConsent;
        });
      </script>
    </div>
    <Navigation />
    <main class="flex flex-col" class:list={[className || "pt-5 md:pt-8 lg:pt-11 xl:pt-16 pb-5 md:pb-8 lg:pb-11 xl:pb-16 pl-2 md:pl-12 lg:pl-10 xl:pl-14 pr-2 md:pr-12 lg:pr-10 xl:pr-14 gap-4 md:gap-5 lg:gap-4", className]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
