---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  autor?: string;
  type?: string;
  keywords?: string;
  spanish?: string;
  english?: string;
}

const {
  title = 'HyperGamerX: Tu Destino para Noticias de Videojuegos',
  description = 'Descubre las últimas noticias y curiosidades en el mundo de los videojuegos. Reseñas, avances, análisis y más, HyperGamerX tu fuente de información',
  image = '/logo4.png',
  autor = 'Sunrize Studios',
  type = 'website',
  keywords = 'videojuegos, noticias, reseñas, análisis, avances, curiosidades, HyperGamerX, HyperGamerX.com',
  spanish = 'https://www.hypergamerx.com/es',
  english = 'https://www.hypergamerx.com/en',
} = Astro.props;

import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      autor={autor}
      type={type}
      keywords={keywords}
      spanish={spanish}
      english={english}
    />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <ViewTransitions />
    <script
      async
      src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8225968446465041'
      crossorigin='anonymous'></script>
  </head>
  <body>
    <Nav />
    <main class="'w-full flex flex-col mb-10'">
      <slot />
    </main>
    <Footer />
  </body>
</html>
