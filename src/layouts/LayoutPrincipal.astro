---
import HeadTags from '../components/utils/HeadTags.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  autor?: string;
  type?: string;
  keywords?: string;
}

const {
  title = 'HyperGamerX: Tu Destino para Noticias de Videojuegos',
  description = 'Descubre las últimas noticias y curiosidades en el mundo de los videojuegos. Reseñas, avances, análisis y más, HyperGamerX tu fuente de información.',
  image = '',
  autor = 'Sunrize Studios',
  type = 'website',
  keywords = 'videojuegos, noticias, reseñas, análisis, avances, curiosidades, HyperGamerX, HyperGamerX.com',
} = Astro.props;

import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
  <head>
    <HeadTags
      title={title}
      description={description}
      image={image}
      autor={autor}
      type={type}
      keywords={keywords}
      publishtime={new Date().toISOString()}
      updatetime={new Date().toISOString()}
      lang={lang}
    />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <ViewTransitions />

    <script
      async
      src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8225968446465041'
      crossorigin='anonymous'></script>
    <script type='text/partytown' async src='https://www.googletagmanager.com/gtag/js?id=G-KW6PKZ3FV9'></script>
    <script type='text/partytown'>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-KW6PKZ3FV9');
    </script>
    <meta name='publisuites-verify-code' content='aHR0cHM6Ly93d3cuaHlwZXJnYW1lcnguY29t' />
  </head>
  <body class='bg-gray-950 text-white'>
    <Nav />
    <div lang={lang} class='w-full lg:w-11/12 mx-auto flex flex-col mb-10'>
      <slot />
    </div>
    <Footer />
  </body>
</html>
