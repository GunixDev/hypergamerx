---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { getLangFromUrl } from '../i18n/utils';
import { getCollection } from 'astro:content';
import ListArticlesBlog from '../components/admin/ListArticlesBlog.tsx';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  autor?: string;
  type?: string;
  keywords?: string;
  spanish?: string;
  english?: string;
}

const {
  title = 'HyperGamerX: Tu Destino para Noticias de Videojuegos',
  description = 'Descubre las últimas noticias y curiosidades en el mundo de los videojuegos. Reseñas, avances, análisis y más, HyperGamerX tu fuente de información',
  image = '/logo4.png',
  autor = 'Sunrize Studios',
  type = 'website',
  keywords = 'videojuegos, noticias, reseñas, análisis, avances, curiosidades, HyperGamerX, HyperGamerX.com',
  spanish = 'https://www.hypergamerx.com/es/',
  english = 'https://www.hypergamerx.com/en/',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const allBlogPosts = await getCollection('blog', (data) => {
  return data.slug.startsWith(lang);
});

const sortallBlogPosts = allBlogPosts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      autor={autor}
      type={type}
      keywords={keywords}
      spanish={spanish}
      english={english}
      publishtime={new Date().toISOString()}
      updatetime={new Date().toISOString()}
    />
    <link rel='sitemap' href='/sitemap-index.xml' />
    <ViewTransitions />
  </head>
  <body class='bg-gray-950 text-white'>
    <ListArticlesBlog lang={lang} list={sortallBlogPosts} client:load />
    <Nav />
    <main class='w-full lg:w-11/12 mx-auto flex flex-col mb-10'>
      <slot />
    </main>
    <Footer />
  </body>
</html>
