---
import { getLangFromUrl } from '../i18n/utils';
import MobileNav from '../components/util/Mobilenav.tsx';

const lang2 = getLangFromUrl(Astro.url);
let pathname = Astro.url.pathname.replace(/\/[a-z]{2}\//, '');

if (pathname === '/en') {
  pathname = '';
} else if (pathname === '/es') {
  pathname = '';
}
---

<MobileNav lang2={lang2} pathname={pathname} client:load />
