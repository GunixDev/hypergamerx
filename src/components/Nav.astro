---
import {getLangFromUrl} from '../i18n/utils';
import NavPreact from './utils/nav/NavPreact';

const lang2 = getLangFromUrl(Astro.url);
let pathname = Astro.url.pathname.replace(/\/[a-z]{2}\//, '');

if (pathname === '/en') {
  pathname = '';
} else if (pathname === '/es') {
  pathname = '';
}

if (pathname === '/') {
  pathname = '';
}
---

<NavPreact lang2={lang2} pathname={pathname} client:load/>
