---
interface Props {
  file: string;
  data: any;
  lang: any;
}

const { file, data, lang } = Astro.props;
const { Image, PubDate, Title } = data;
const fileName = file.split('/').pop()?.split('.')[0];
let fechaFormateada = new Date(PubDate).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' });
---

<a href={`/${lang}/blog/${fileName}/`} hreflang={lang} class='h-full w-full group duration-500'>
  <div class='grid grid-flow-row-dense'>
    <div>
      {
        Image !== null ? (
          <img
            src={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_165/${Image}`}
            srcset={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_55/${Image} 256w,
             https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_110/${Image} 512w,
             https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_165/${Image} 768w,
             https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_220/${Image} 1024w,
             https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_274/${Image} 1280w`}
            width='165'
            height='93'
            alt={`${Image}`}
            decoding='async'
            loading='lazy'
            class=' w-full h-full group-hover:brightness-50 duration-500'
          />
        ) : (
          <img
            src={`/logo3.png`}
            width='165'
            height='93'
            alt={`sin imagen`}
            decoding='async'
            loading='lazy'
            class=' w-full h-full group-hover:brightness-50 duration-500'
          />
        )
      }
    </div>
    <div>
      <p class='text-xs ls:max-sm:hidden text-blue-500 lg:font-bold lg:my-1'>{fechaFormateada}</p>
      <h3 class='text-xs md:text-sm text-slate-400 group-hover:text-slate-100 duration-500'>{Title}</h3>
    </div>
  </div>
</a>
