---
interface Props {
  file: string;
  data: any;
  lang: any;
}
const { file, data, lang } = Astro.props;
const { ImageCover, PubDate, Title } = data;
const fileName = file.split('/').pop()?.split('.')[0];
let fecha = new Date(PubDate).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' });
---

<a hrefLang={lang} href={`/${lang}/blog/${fileName}/`}>
  <div class='grid grid-cols-11'>
    <div class='col-span-5'>
      {
        ImageCover !== null ? (
          <img
            src={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_50/c_scale,w_162/${ImageCover}`}
            srcset={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_50/c_scale,w_54/${ImageCover} 256w,
           https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_50/c_scale,w_108/${ImageCover} 512w,
           https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_50/c_scale,w_162/${ImageCover} 768w,
           https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_50/c_scale,w_216/${ImageCover} 1024w,
           https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_50/c_scale,w_270/${ImageCover} 1280w`}
            alt={`${ImageCover}`}
            decoding='async'
            loading='lazy'
            class='h-full w-full rounded-md aspect-auto'
          />
        ) : (
          <img
            src='/Banner.png'
            width='83'
            height='47'
            alt={`${ImageCover}`}
            decoding='async'
            loading='lazy'
            class='h-full w-full rounded-md aspect-auto'
          />
        )
      }
    </div>
    <div>
      <div class='absolute ml-[8px]'>
        <h3 class='z-40 subtitulo6-desktop'>{Title}</h3>
        <p class='z-40 text-xs'>{fecha}</p>
      </div>
    </div>
  </div>
</a>
