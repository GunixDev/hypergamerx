---
interface Props {
  image?: {
    src?: string;
    width?: number;
    height?: number;
    alt?: string;
    meta?: { storageKey?: string };
  } | null;
  alt?: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  widths?: number[];
  quality?: number;
  [key: string]: unknown;
}

const { image, alt, class: className, loading = "lazy", fetchpriority, sizes = "100vw", widths = [480, 800, 1200], quality = 80, ...rest } = Astro.props;

const storageKey = image?.meta?.storageKey;
const original = (storageKey ? Astro.locals.emdash?.getPublicMediaUrl?.(storageKey) : undefined) ?? image?.src;

const CDN = "https://media.hypergamerx.com/";
const isCdn = original?.startsWith(CDN);

const available = [...new Set(widths.map((w) => (image?.width ? Math.min(w, image?.width) : w)))].sort((a, b) => a - b);

const variant = (w: number) => `${CDN}cdn-cgi/image/width=${w},quality=${quality},format=auto/${original!.slice(CDN.length)}`;

const src = isCdn && available.length ? variant(available[available.length - 1]) : original;
const srcset = isCdn && available.length ? available.map((w) => `${variant(w)} ${w}w`).join(", ") : undefined;

const decoding = loading === "eager" || fetchpriority === "high" ? "sync" : "async";
---

{
  src && (
    <img
      src={src}
      srcset={srcset}
      sizes={srcset ? sizes : undefined}
      alt={alt}
      width={image?.width}
      height={image?.height}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      data-fallback={original}
      {...rest}
    />
  )
}
