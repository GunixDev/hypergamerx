---
interface Props {
	title: string;
	path: string;
	aside?: boolean;
}

const { title, path, aside = false } = Astro.props;
---

<div class="flex justify-between items-center w-full">
	<h2 class:list={["font-bold", { "font-lg": aside }]}>
		{title}
	</h2>

	<a href={path} class="flex justify-end items-center gap-2 transition-colors">
		<span aria-hidden="true" class="w-0.5 h-3 lg:h-4 bg-neutral-400"></span>
		<span class:list={[aside ? "font-xs" : "font-sm"]}>
			Ver más <span class="sr-only">{title}</span>
		</span>
	</a>
</div>