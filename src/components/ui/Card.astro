---
import { type ContentEntry, type ReferencePages } from "emdash";
import type { Post } from "@/emdash-env";
import FormatDate from "@components/ui/FormatDate.astro";
import MediaImage from "@components/ui/MediaImage.astro";

interface Props {
  modo: "main" | "list" | "card";
  post: ContentEntry<Post, ReferencePages>;
  loading?: "lazy" | "eager";
  heading?: "h2" | "h3" | "none";
}

const { loading = "lazy", modo, heading = "none", post } = Astro.props;
const { title, description, publishedAt, slug } = post.data;

const slugPath = `/blog/${slug}`;

const sizesByMode = {
  main: "(min-width: 1024px) 700px, 100vw",
  list: "(min-width: 1280px) 20vw, (min-width: 768px) 25vw, 50vw",
  card: "(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 50vw",
};
---

<a href={slugPath} aria-label={title} class="flex">
  {
    modo === "main" ? (
      <article class="card-rounded relative inline-flex flex-col justify-end group">
        <MediaImage image={post.data.cover} alt={post.data.cover.alt} class="object-cover group-hover:saturate-150 group-hover:contrast-125 transition-all" loading={loading} sizes={sizesByMode.main} widths={[480, 800, 1200]} />
        <div class="absolute inset-0 bg-linear-to-t from-neutral-950" />

        <div class="m-4 absolute font-xs gap-1 md:gap-1.5 lg:gap-2 text-full-white">
          {heading === "h3" ? <h3 class="font-bold">{title}</h3> : heading === "h2" ? <h2 class="font-bold">{title}</h2> : <span class="font-bold">{title}</span>}
          <FormatDate date={publishedAt} />
          <p class="font-xs">{description}</p>
        </div>
      </article>
    ) : modo === "list" ? (
      <article class="card-rounded grid grid-cols-2 gap-1 md:gap-1.5 lg:gap-2 overflow-hidden group">
        <div class="relative">
          <span class="flex px-1 md:px-1.5 lg:px-2 xl:px-2.5 py-px md:py-0.5 xl:py-1 justify-center items-center absolute bottom-0 left-0 z-10 bg-full-black card-rounded-tr font-xs text-full-white">
            <FormatDate date={publishedAt} />
          </span>
          <MediaImage image={post.data.cover} alt={post.data.cover.alt} class="block w-full aspect-video object-cover card-rounded group-hover:saturate-150 group-hover:contrast-125 duration-700 transition-all" loading={loading} sizes={sizesByMode.list} widths={[360, 720]} />
        </div>
        <div class="flex flex-col gap-1">
          {heading === "h3" ? <h3 class="font-bold">{title}</h3> : heading === "h2" ? <h2 class="font-bold">{title}</h2> : <span class="font-bold">{title}</span>}
          <p class="font-xs line-clamp-2 xl:line-clamp-none">{description}</p>
        </div>
      </article>
    ) : (
      <article class="card-rounded flex flex-col gap-1 md:gap-1.5 lg:gap-2 group">
        <div class="relative">
          <span class="flex px-1 md:px-1.5 lg:px-2 xl:px-2.5 py-px md:py-0.5 xl:py-1 justify-center items-center absolute bottom-0 left-0 z-10 bg-full-black card-rounded-tr font-xs text-full-white">
            <FormatDate date={publishedAt} />
          </span>
          <MediaImage image={post.data.cover} alt={post.data.cover.alt} class="object-cover card-rounded group-hover:saturate-150 group-hover:contrast-125 transition-all" loading={loading} sizes={sizesByMode.card} widths={[360, 720, 1080]} />
        </div>
        <div class="flex flex-col gap-1">
          {heading === "h3" ? <h3 class="font-bold">{title}</h3> : heading === "h2" ? <h2 class="font-bold">{title}</h2> : <span class="font-bold">{title}</span>}
          <p class="font-xs">{description}</p>
        </div>
      </article>
    )
  }
</a>
