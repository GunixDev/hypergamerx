---
import HyperGamerX from "../../../public/logos/hyperGamerX.svg";
import HyperGamerXLetter from "../../../public/logos/hyperGamerXLetter.svg"
import Discord from "../../../public/logos/discord.svg";
import Twitter from "../../../public/logos/twitter.svg";
import Facebook from "../../../public/logos/facebook.svg";
import Whatsapp from "../../../public/logos/whatsapp.svg";
import Flipboard from "../../../public/logos/flipboard.svg";
---

<footer class='flex flex-col items-start bg-neutral-950 text-neutral-200 gap-2.5 xl:gap-6 px-2.5 py-2.5 md:px-7 md:py-3 lg:px-10 lg:py-5 xl:px-24 xl:py-9 self-stretch'>
	<div class='flex flex-col items-start gap-2.5 self-stretch'>
		<div class='flex items-center gap-2.5 self-stretch'>
			<HyperGamerX class='w-8 h-8 md:w-12 md:h-12 lg:w-16 lg:h-16' />
			<HyperGamerXLetter class='w-[210px] md:w-[220px] lg:w-[340px] xl:w-[400px] h-auto aspect-189/20' />
		</div>

		<div class='grid md:grid-cols-2 items-start content-start self-stretch gap-2.5'>
			<div class='flex flex-col items-start flex-[1 0 0] gap-1.5 w-full'>
				<span class='font-base font-bold text-neutral-50'>Redes</span>
				<div class='flex gap-x-2 md:gap-x-2 lg:gap-x-3 xl:gap-x-5 self-stretch'>
					<a href='https://discord.gg/KqmwVhZnfa' aria-label='Servidor de discord' class='flex items-center gap-1 md:gap-1.5 lg:gap-2 xl:gap-2.5'>
						<Discord class='rounded w-5 h-5 md:w-6 md:h-6 xl:w-8 xl:h-8' />
					</a>
					<a href='https://x.com/HyperGamerX_' aria-label='Red de X' class='flex items-center gap-1 md:gap-1.5 lg:gap-2 xl:gap-2.5'>
						<Twitter class='rounded w-5 h-5 md:w-6 md:h-6 xl:w-8 xl:h-8 border-white border' />
					</a>
					<a href='https://www.facebook.com/Hypergamerx' aria-label='Red de Facebook' class='flex items-center gap-1 md:gap-1.5 lg:gap-2 xl:gap-2.5'>
						<Facebook class='rounded w-5 h-5 md:w-6 md:h-6 xl:w-8 xl:h-8' />
					</a>
					<a href='https://whatsapp.com/channel/0029VaH91EaAO7RD5tegmL1z' aria-label='Comunidad de Whatsapp' class='flex items-center gap-1 md:gap-1.5 lg:gap-2 xl:gap-2.5'>
						<Whatsapp class='rounded w-5 h-5 md:w-6 md:h-6 xl:w-8 xl:h-8' />
					</a>
					<a href='https://flipboard.com/@HyperGamerX?from=share&utm_source=flipboard&utm_medium=curator_share' aria-label='Red de Flipboard' class='flex items-center gap-1 md:gap-1.5 lg:gap-2 xl:gap-2.5'>
						<Flipboard class='rounded w-5 h-5 md:w-6 md:h-6 xl:w-8 xl:h-8' />
					</a>
				</div>
			</div>

			<div class='grid grid-cols-2 gap-4 flex-[1 0 0] w-full'>
				<div class='flex flex-col items-start gap-1.5 self-stretch'>
					<span class='font-bold font-base text-neutral-50'>Avisos y Políticas</span>
					<div class='flex flex-col w-full gap-2'>
						<a href=`/avisos-y-politicas/privacidad/` class='underline font-sm'>Política de Privacidad</a>
						<a href=`/avisos-y-politicas/politica-de-cookies/` class='underline font-sm'>Política de Cookies</a>
						<a href=`/avisos-y-politicas/aviso-legal/` class='underline font-sm'>Aviso Legal</a>
						<p data-cc='show-preferencesModal' transition:persist class='font-sm underline cursor-pointer'>
							Editar Cookies
						</p>
					</div>
				</div>

				<div class='flex flex-col items-start gap-0.5 self-stretch'>
					<span class='font-bold font-base text-neutral-50'>Conócenos</span>
					<div class='flex flex-col w-full gap-2'>
						<a href={`/conocenos/sobre-hypergamerx/`} class='underline font-sm'>Sobre HyperGamerX</a>
						<a href={"https://www.paypal.com/donate/?hosted_button_id=K7PXSGWS98LXQ"} class='underline font-sm'>Donate</a>
						<a href={`/conocenos/contacto/`} class='underline font-sm'>Contacto/Publicidad</a>
					</div>
				</div>
			</div>
		</div>
		<p class='flex py-0.5 content-center font-sm items-center self-stretch'>
			© 2023 - 2025 HyperGamerX. Creado por&nbsp;
			<a class='text-blue-500 hover:text-blue-600 duration-500' href='https://brayan-cordova.vercel.app/'>Brayan Cordova</a>
		</p>
	</div>
</footer>
