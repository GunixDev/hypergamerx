---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  autor?: string;
  type?: string;
  class?: string;
  robots?: string;
  pubDate?: string;
  updatedDate?: string;
}

const { title, description, image, imageAlt, autor, type, robots, pubDate, updatedDate } = Astro.props;

const siteUrl = Astro.site ?? new URL("https://hypergamerx.com");
const currentPath = Astro.url.pathname;
const cleanPath = currentPath !== "/" && currentPath.endsWith("/") ? currentPath.slice(0, -1) : currentPath;
const canonicalURL = new URL(cleanPath, siteUrl);

const imageURL = image ? new URL(image, siteUrl).toString() : undefined;

console.log(imageURL)

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "HyperGamerX",
  url: siteUrl.toString(),
  inLanguage: "es-PE",
};

const articleSchema =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        url: canonicalURL.toString(),
        ...(imageURL ? { image: [imageURL] } : {}),
        ...(pubDate ? { datePublished: pubDate } : {}),
        ...(updatedDate ? { dateModified: updatedDate } : {}),
        inLanguage: "es-PE",
        author: {
          "@type": "Person",
          name: autor,
        },
        publisher: {
          "@type": "Organization",
          name: "HyperGamerX",
          url: siteUrl.toString(),
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL.toString(),
        },
      }
    : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script type="text/javascript">
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = "https://www.clarity.ms/tag/" + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, "clarity", "script", "k72kfj6bzg");
</script>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={autor} />
<meta name="creator" content={autor} />
<meta name="application-name" content="HyperGamerX" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robots} />
<meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1" />
<meta http-equiv="Content-Language" content="es" />
<meta name="format-detection" content="telephone=no, address=no, email=no" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<link rel="alternate" hreflang="es" href={canonicalURL.toString()} />
<link rel="alternate" hreflang="x-default" href={canonicalURL.toString()} />
<link rel="canonical" href={canonicalURL.toString()} />
<link rel="sitemap" href="/sitemap.xml" />

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="mask-icon" href="/favicon.ico" color="#8D46E7" />

<meta property="fb:profile_id" content="https://www.facebook.com/hypergamerx" />

<meta property="og:type" content={type === "article" ? "article" : "website"} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="es_PE" />
<meta property="og:site_name" content="HyperGamerX" />

{
  type === "article" && (
    <>
      {pubDate && <meta property="article:published_time" content={pubDate} />}
      {updatedDate && <meta property="article:modified_time" content={updatedDate} />}
      <meta property="article:author" content={autor} />
      <meta property="article:section" content="Videojuegos" />
    </>
  )
}

{
  imageURL && (
    <>
      <meta property="og:image" content={imageURL} />
      <meta property="og:image:secure_url" content={imageURL} />
      {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
      <meta property="og:image:width" content="958" />
      <meta property="og:image:height" content="540" />
      <meta property="og:image:type" content="image/webp" />
      <meta name="twitter:image" content={imageURL} />
      {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    </>
  )
}

<meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={canonicalURL.toString()} />
<meta name="twitter:site" content="@HyperGamerX_" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:creator" content="@HyperGamerX_" />

<meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#010101" />
<meta name="color-scheme" content="dark light" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="HyperGamerX" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="msapplication-config" content="/browserconfig.xml" />

<link rel="alternate" type="application/rss+xml" title="HyperGamerX" href={new URL("/rss.xml", siteUrl).toString()} />

<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
