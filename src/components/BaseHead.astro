---
interface Props {
  title: string;
  description: string;
  image: string;
  autor: string;
  type: string;
  keywords: string;
  spanish: string;
  english: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, autor, type, keywords, english, spanish } = Astro.props;
---

<!-- Global Metadata -->
<meta charset='utf-8' />
<title>{title}</title>
<meta name='title' content={title} />
<meta name='description' content={description} />
<meta name='application-name' content='HyperGamerX' />
<meta name='author' content={autor} />
<meta name='generator' content={Astro.generator} />
<meta
  name='keywords'
  content=`${keywords}, HyperGamerX, videojuegos que son, videojuegos de decisiones pc, clases de videojuegos,videojuegos mas famosos, generos de videojuegos, cual es el juego mas famoso del mundo, videojuegos populares, Noticias de videojuegos, Curiosidades de videojuegos, Últimas novedades en videojuegos`
/>
<link rel='canonical' href={canonicalURL} />
<link rel='alternate' hreflang='es' href={spanish} />
<link rel='alternate' hreflang='en' href={english} />
<meta name='viewport' content='width=device-width,initial-scale=1' />
<meta name='creator' content={autor} />
<meta name='publisher' content={autor} />
<meta name='robots' content='index, follow' />
<meta name='googlebot' content='index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1' />
<meta name='format-detection' content='telephone=no, address=no, email=no' />
<meta property='article:published_time' content='2023-08-29T14:33:38.956Z' />
<meta property='article:author' content={autor} />

<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<meta property='og:type' content={type} />
<meta property='og:url' content={Astro.url} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:image' content={new URL(image, Astro.url)} />

<meta property='twitter:card' content='summary_large_image' />
<meta property='twitter:url' content={Astro.url} />
<meta property='twitter:title' content={title} />
<meta property='twitter:description' content={description} />
<meta property='twitter:image' content={new URL(image, Astro.url)} />
