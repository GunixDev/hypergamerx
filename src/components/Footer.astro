---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class='text-white bg-gray-900 bg-opacity-70 py-2 md:py-8 w-full font-sans mt-4 md:mt-10 ls:max-sm:hidden'>
  <div class='md:container text-slate-500 mx-auto text-center grid grid-cols-3 list-none'>
    <div class='text-left'>
      <p class='text-gray-400 lg:font-bold ls:max-sm:text-xs'>{t('footer.terminos')}</p>
      <div class='ml-6 ls:max-md:text-xs'>
        <ol>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={`/${lang}/terminos-servicios/AvisoLegal/`}>{t('footer.avisolega')}</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={`/${lang}/terminos-servicios/PoliticaCookies/`}>{t('footer.politicascookies')}</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={`/${lang}/terminos-servicios/Privacidad/`}>{t('footer.politicas')}</a>
          </li>
        </ol>
      </div>
    </div>
    <div class='text-left'>
      <p class='text-gray-400 lg:font-bold ls:max-sm:text-xs'>{t('footer.redes')}</p>
      <div class='ml-6 ls:max-md:text-xs'>
        <ol>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={'https://discord.gg/aXmCVfcXaa'} target='_blank'> Discord</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={'https://twitter.com/HyperGamerX_ES'} target='_blank'> Twitter</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={'https://www.youtube.com/@HyperGamerX1'} target='_blank'> Youtube</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={'https://www.facebook.com/Hypergamerx'} target='_blank'> Facebook</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={'https://whatsapp.com/channel/0029VaH91EaAO7RD5tegmL1z'} target='_blank'> Whatsapp</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={'https://www.instagram.com/hypergamerx1/'} target='_blank'> Instagram</a>
          </li>
        </ol>
      </div>
    </div>
    <div>
      <p class='text-gray-400 ls:max-lg:text-xs'>
        &copy; 2023 HyperGamerX. {t('article.creadorpor')}
        <a href={'https://sunrizestudios.vercel.app/'} target='_blank' class='duration-300 hover:text-red-300'>
          {' '}
           Sunrize Studios
        </a>
      </p>
    </div>
  </div>
</footer>
