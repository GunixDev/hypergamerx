---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
import Redes from './utils/footer/Redes';
---

<footer class='text-white bg-gray-900 bg-opacity-70 py-2 md:py-8 w-full font-sans mt-4 md:mt-10 ls:max-md:hidden'>
  <div class='md:container text-slate-500 mx-auto text-center grid grid-cols-4 list-none'>
    <div class='text-left'>
      <p class='text-gray-400 lg:font-bold ls:max-sm:text-xs'>{t('footer.terminos')}</p>
      <div class='ml-6 ls:max-md:text-xs'>
        <ol>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={`/${lang}/terminos-servicios/AvisoLegal/`} hreflang={lang}>{t('footer.avisolega')}</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={`/${lang}/terminos-servicios/PoliticaCookies/`} hreflang={lang}>{t('footer.politicascookies')}</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={`/${lang}/terminos-servicios/Privacidad/`} hreflang={lang}>{t('footer.politicas')}</a>
          </li>
        </ol>
      </div>
    </div>
    <div class='text-left'>
      <p class='text-gray-400 lg:font-bold ls:max-sm:text-xs'>{t('footer.contactoseconocenos')}</p>
      <div class='ml-6 ls:max-md:text-xs'>
        <ol>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={'https://www.paypal.com/donate/?hosted_button_id=K7PXSGWS98LXQ'} hreflang={lang}>
              {t('footer.donar')}</a
            >
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={`/${lang}/about/`} hreflang={lang}> {t('footer.sobrehypergamerx')}</a>
          </li>
          <li class='m-2 duration-300 lg:text-gray-200 lg:font-semibold hover:text-gray-300'>
            <a href={'mailto:sunrizecontact@gmail.com'} hreflang={lang}> {t('footer.contacto')}</a>
          </li>
        </ol>
      </div>
    </div>
    <Redes lang={lang} />
    <div>
      <p class='text-gray-400 ls:max-lg:text-xs'>
        &copy; 2024 HyperGamerX. {t('article.creadorpor')}
        <a
          href={'https://sunrizestudios.vercel.app/'}
          hreflang={lang}
          target='_blank'
          class='duration-300 hover:text-red-300'>
          {' '}
          Sunrize Studios
        </a>
      </p>
    </div>
  </div>
</footer>
