---
interface Props {
  file: string;
  data: any;
}
const { file, data } = Astro.props;
const { image, pubDate, title, description } = data;
const fileName = file.split('/').pop()?.split('.')[0];
let fechaFormateada = new Date(pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
import Carrusel from '../components/util/carrusel';
---

<div class='relative w-full h-64 lg:h-96 group duration-500'>
  <Carrusel image={image} title={title} description={description} fileName={fileName} fecha={fechaFormateada} />
</div>
