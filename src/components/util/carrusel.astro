---
interface Props {
  image: any;
  title: any;
  description: any;
  fileName: any;
  fecha: any;
}

const { image, title, description, fileName, fecha }: Props = Astro.props;
import { Image } from 'astro:assets';
---

<a href={`/blog/${fileName}`}>
  <div>
    <div class='rounded-l-xl w-full bg-gradient-to-t from-black absolute z-20 h-64 lg:h-96'></div>
    {
      image !== null ? (
        <Image
          alt={`image`}
          src={image}
          width={870}
          height={472}
          quality={'low'}
          format='avif'
          class='rounded-l-xl w-full object-cover fill-neutral-500 brightness-75 group-hover:brightness-50 transition-all duration-500 ease-in-out z-0 absolute h-64 lg:h-96'
        />
      ) : (
        <Image
          width={870}
          height={472}
          quality={'low'}
          format='avif'
          alt='sin imagen'
          src='/logo3.png'
          class='rounded-xl ls:max-sm:hidden'
        />
      )
    }
  </div>
  <div class='absolute w-11/12 left-5 bottom-0 z-50 mb-4'>
    <h3 class='z-50 font-bold text-lg lg:text-2xl ls:max-md:text-xs'>
      {title}
    </h3>
    <p class='z-50 text-xs lg:text-base my-1 text-blue-500'>{fecha}</p>
    <p class='z-50 lg:text-lg text-xs ls:max-md:hidden'>{description}</p>
  </div>
</a>
