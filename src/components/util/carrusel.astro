---
interface Props {
  image: any;
  title: any;
  description: any;
  fileName: any;
  fecha: any;
  lang: any;
}

const { image, title, description, fileName, fecha, lang }: Props = Astro.props;
---

<a href={`/${lang}/blog/${fileName}/`}>
  <div>
    <div class='rounded-l-xl w-full bg-gradient-to-t from-black to-transparent absolute z-30 h-full'></div>
    {
      image !== null ? (
        <img
          width='408'
          height='230'
          src={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_408/${image}`}
          srcset={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_136/${image} 256w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_272/${image} 512w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_408/${image} 768w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_544/${image} 1024w,
          https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_680/${image} 1280w`}
          alt={`${image}`}
          class='rounded-l-xl h-full w-full object-cover fill-neutral-500 brightness-75 group-hover:brightness-50 transition-all duration-500 ease-in-out z-0 absolute mx-auto'
        />
      ) : (
        <img
          src='/logo3.png'
          alt='image'
          class='rounded-l-xl w-full fill-neutral-500 brightness-75 group-hover:brightness-50 transition-all duration-500 ease-in-out z-0 absolute h-full'
        />
      )
    }
  </div>
  <div class='absolute w-full ls:max-sm:mx-1 md:w-11/12 md:left-5 bottom-0 z-50 mb-2 md:mb-4'>
    <h3 class='z-40 text-white font-medium lss:font-extrabold text-lg lg:text-2xl ls:max-md:text-xs'>
      {title}
    </h3>
    <p class='z-40 text-xs lg:text-base my-1 text-blue-500'>{fecha}</p>
    <p class='z-40 lg:text-lg text-xs ls:max-lss:hidden'>{description}</p>
  </div>
</a>
