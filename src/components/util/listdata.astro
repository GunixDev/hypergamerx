---
interface Props {
  image: any;
  title: any;
  fileName: any;
  fecha: any;
  lang: any;
}
const { image, title, fileName, fecha, lang } = Astro.props;
import { Image } from 'astro:assets';
---

<a href={`/${lang}/blog/${fileName}/`}>
  <div class='grid lg:grid-flow-col-dense lg:grid-cols-5'>
    <div class='lg:col-span-2'>
      {
        image !== null ? (
          <Image
            alt={`image`}
            src={image}
            width={870}
            height={472}
            quality={'low'}
            format='webp'
            class='rounded-xl w-full h-[104px] object-cover fill-neutral-500 brightness-75  group-hover:brightness-50 transition-all duration-500 ease-in-out ls:max-lg:hidden '
          />
        ) : (
          <Image
            width={870}
            height={472}
            quality={'low'}
            format='webp'
            alt='sin imagen'
            src='/logo3.png'
            class='rounded-xl ls:max-sm:hidden'
          />
        )
      }
    </div>
    <div>
      <div class='lg:absolute'>
        <h2 class='z-50 text-white font-bold md:ml-2 text-xs md:text-base'>{title}</h2>
        <p class='z-50 font-bold ml-2 text-xs text-blue-600 md:font-extrabold ls:max-md:hidden'>{fecha}</p>
      </div>
    </div>
  </div>
</a>
