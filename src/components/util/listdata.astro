---
interface Props {
  file: string;
  data: any;
  lang: any;
}
const { file, data, lang } = Astro.props;
const { image, pubDate, title } = data;
const fileName = file.split('/').pop()?.split('.')[0];
let fecha = new Date(pubDate).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' });
import { Image } from 'astro:assets';
---

<a href={`/${lang}/blog/${fileName}/`} class='group duration-500'>
  <div class='grid lg:grid-cols-5'>
    <div class='lg:col-span-2'>
      {
        image !== null ? (
          <img
            src={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_479/${image}`}
            srcset={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_160/${image} 256w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_319/${image} 512w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_479/${image} 768w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_639/${image} 958w 1024w,
          https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_958/${image} 958w`}
            alt='image'
            class='w-full h-auto fill-neutral-500 brightness-75  group-hover:brightness-50 transition-all duration-500 ease-in-out ls:max-lg:hidden '
          />
        ) : (
          <Image
            width={870}
            height={472}
            quality={'low'}
            format='webp'
            alt='sin imagen'
            src='/logo3.png'
            class='rounded-xl ls:max-sm:hidden'
          />
        )
      }
    </div>
    <div>
      <div class='lg:absolute'>
        <h3 class='z-50 text-white font-normal lss:font-bold md:ml-2 text-xs md:text-base'>{title}</h3>
        <p class='z-50 font-bold ml-2 text-xs text-blue-600 md:font-extrabold ls:max-lss:hidden'>{fecha}</p>
      </div>
    </div>
  </div>
  <hr class='lss:mt-1' />
</a>
