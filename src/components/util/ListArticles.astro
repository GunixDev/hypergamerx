---
interface Props {
  image: any;
  title: any;
  fileName: any;
  fecha: any;
  lang: any;
}
const { image, title, fileName, fecha, lang }: Props = Astro.props;
import { Image } from 'astro:assets';
---

<a href={`/${lang}/blog//${fileName}/`}>
  <div class='grid grid-flow-row-dense'>
    <div>
      {
        image !== null ? (
          <Image
            alt={`image`}
            src={image}
            width={870}
            format='webp'
            height={472}
            quality={'low'}
            class='rounded-t-xl w-full h-full group-hover:brightness-50 duration-500'
          />
        ) : (
          <Image
            alt={`image`}
            src={'/logo3.png'}
            width={870}
            format='webp'
            height={472}
            class='rounded-xl duration-500 object-cover group-hover:brightness-50  h-16 md:h-36'
          />
        )
      }
    </div>
    <div>
      <p class='text-xs text-blue-600 lg:my-1'>{fecha}</p>
      <h3 class='text-xs md:text-sm text-slate-400 group-hover:text-slate-100 duration-500'>{title}</h3>
    </div>
  </div>
</a>
