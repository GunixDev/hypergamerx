---
interface Props {
  image: any;
  title: any;
  fileName: any;
  fecha: any;
  lang: any;
}
const { image, title, fileName, fecha, lang }: Props = Astro.props;
import { Image } from 'astro:assets';
---

<a href={`/${lang}/blog/${fileName}/`}>
  <div class='grid grid-flow-row-dense'>
    <div>
      {
        image !== null ? (
          <img
            src={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_165/${image}`}
            srcset={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_55/${image} 256w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_110/${image} 512w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_165/${image} 768w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_220/${image} 958w 1024w,
          https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_274/${image} 958w`}
            alt={`imagen de ${image}`}
            decoding='async'
            loading='lazy'
            class=' w-fit h-fit group-hover:brightness-50 duration-500'
          />
        ) : (
          <Image
            alt={`image`}
            src={'/logo3.png'}
            width={870}
            format='webp'
            height={472}
            class='rounded-xl duration-500 group-hover:brightness-50 h-full w-full'
          />
        )
      }
    </div>
    <div>
      <p class='text-xs ls:max-sm:hidden text-blue-600 lg:my-1'>{fecha}</p>
      <h3 class='text-xs md:text-sm text-slate-400 group-hover:text-slate-100 duration-500'>{title}</h3>
    </div>
  </div>
</a>
