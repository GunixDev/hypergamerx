---
import {useTranslations} from '@i18n/utils';
import type {Locale} from '@/types';

interface Props {
  data: any;
  locale: Locale;
}

const {data, locale} = Astro.props;
const t = useTranslations(locale);
---

<div class="flex px-3 py-4 sm:px-5 sm:py-6 flex-col items-start gap-4 sm:gap-5 self-stretch rounded bg-neutral-950 text-white">
  <h2 class="font-xl font-bold">{t('blog_indice')}</h2>
  <div class="flex px-1 flex-col items-start gap-2.5">
    {
      data?.map((indice: any) => {
        return indice.depth === 2 ? (
          <a hreflang={locale} href={`#${indice.slug}`} class="font-lg font-bold">
            {indice.text}
          </a>
        ) : indice.depth === 3 ? (
          <a hreflang={locale} href={`#${indice.slug}`} class="font-base">
            {indice.text}
          </a>
        ) : indice.depth === 4 ? (
          <a hreflang={locale} href={`#${indice.slug}`} class="font-sm">
            {indice.text}
          </a>
        ) : null;
      })
    }
  </div>
</div>
