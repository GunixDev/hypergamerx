---
import { useTranslations } from '../i18n/utils';
interface Props {
  data: any;
  lang: any;
}

const { data, lang } = Astro.props;
const t = useTranslations(lang);
---

<div class='bg-slate-950 rounded-2xl w-fit'>
  <h2 class='align-middle font-bold text-white text-center text-2xl'>{t('article.indice')}</h2>
  <div class='grid grid-cols-1'>
    {
      data.map((indice: any) => {
        return indice.depth === 2 ? (
          <a href={`#${indice.slug}`} class='text-xl font-bold text-slate-200 hover:text-slate-300 duration-300 p-1'>
            <ol class=' list-disc ml-2'>
              <li>{indice.text}</li>
            </ol>
          </a>
        ) : indice.depth === 3 ? (
          <a
            href={`#${indice.slug}`}
            class='text-lg ml-4 font-medium text-gray-400 hover:text-slate-300 duration-300 p-1'>
            <ol>
              <li class=' list-none'>{indice.text}</li>
            </ol>
          </a>
        ) : indice.depth === 4 ? (
          <a href={`#${indice.slug}`} class='text-sm ml-11 text-slate-600 hover:text-slate-300 duration-300 p-1'>
            <ol>
              <li class=' list-none'>{indice.text}</li>
            </ol>
          </a>
        ) : null;
      })
    }
  </div>
</div>
