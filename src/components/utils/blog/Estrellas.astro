      </span>
      <span class='ml-1 lg:ml-2 text-xs sm:text-base align-middle text-slate-400'>{cantidad + '  '}</span>
      {cantidad >= 4.5 ? (
        <>
          <img
            src='/icons/star-fill.svg'
            class='inline-block align-middle text-slate-400 ls:max-sm:hidden'
            alt='Star Icon'
          />
