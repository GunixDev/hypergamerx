---
import { getEntryBySlug } from 'astro:content';
import { getLangFromUrl } from '../../../i18n/utils';

interface Props {
  url: string;
  text: string;
}

const { url, text } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const data = await getEntryBySlug('blog', `${lang}/${url}`);
const titulo = data?.data?.Title;
const descripcion = data?.data?.Description;
const arial = `ir al articulo de ${data?.data?.Title}`;
---

<span class='relative group'>
  <a
    class='font-bold duration-300 group'
    style='color: rgb(9, 49, 134)'
    onmouseover="this.style.color='rgb(191 219 254)'"
    onmouseout="this.style.color='rgb(52, 115, 250)'"
    href={`/${lang}/blog/${url}/`}
    aria-label={arial}
    hreflang={lang}>{text}</a
  >
  <a href={`/${lang}/blog/${url}/`} aria-label={arial} target='_blank' hreflang={lang}>
    <span
      class='absolute left-0 w-80 p-2 mt-6 text-white opacity-90 bg-gray-800 rounded shadow-lg hidden group-hover:inline transition duration-500 text-xs z-50 ls:max-sm:hidden'>
      <span class='font-bold lg:text-sm text-white no-underline'>{titulo}</span><br />{descripcion}
    </span>
  </a>
</span>
