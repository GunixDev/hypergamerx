---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../types';
interface Props {
  data: any;
  locale: Locale;
}

const { data, locale } = Astro.props;
const t = useTranslations(locale);
---

<div class='w-fit py-4'>
  <h2 class='align-middle text-center subtitulo4-desktop lg:subtitulo3-desktop'>{t('article.indice')}</h2>
  <div class='grid grid-cols-1'>
    {
      data?.map((indice: any) => {
        return indice.depth === 2 ? (
          <a hreflang={locale} href={`#${indice.slug}`} class='subtitulo5-desktop lg:subtitulo4-desktop p-1.5 lg:pl-1'>
            <ol class=' list-none ml-0'>
              <li>{indice.text}</li>
            </ol>
          </a>
        ) : indice.depth === 3 ? (
          <a
            hreflang={locale}
            href={`#${indice.slug}`}
            class='ml-6 my-2 lg:ml-4 subtitulo6-desktop lg:subtitulo5-desktop'>
            <ol>
              <li class=' list-none'>{indice.text}</li>
            </ol>
          </a>
        ) : indice.depth === 4 ? (
          <a
            hreflang={locale}
            href={`#${indice.slug}`}
            class='ml-10 lg:mt-1 lg:ml-8 minismall-desktop  lg:small-desktop p-1'>
            <ol>
              <li class=' list-none'>{indice.text}</li>
            </ol>
          </a>
        ) : null;
      })
    }
  </div>
</div>
