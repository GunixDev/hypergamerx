---
interface Props {
  title: string;
  description: string;
  image?: string;
  autor: string;
  type: string;
  keywords: string;
  publishtime: string;
  updatetime: string;
  lang?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
let pathname = Astro.url.pathname;
if (pathname.startsWith('/en') || pathname.startsWith('/es')) {
  pathname = canonicalURL.pathname.slice(3);
} else {
  pathname = canonicalURL.pathname;
}
const { title, description, image, autor, type, keywords, publishtime, updatetime, lang } = Astro.props;
---

<meta charset='utf-8' />
<title>{title}</title>
<meta name='apple-mobile-web-app-capable' content='yes' />
<meta name='title' content={title} />
<meta name='description' content={description} />
<meta name='application-name' content='HyperGamerX' />
<meta name='author' content={autor} />
<meta name='generator' content={Astro.generator} />
<meta property='fb:profile_id' content='https://www.facebook.com/hypergamerx' />
<meta
  name='keywords'
  content=`${keywords}, HyperGamerX, ${lang === "es" ? "videojuegos que son, videojuegos de decisiones pc, clases de videojuegos,videojuegos mas famosos, generos de videojuegos, cual es el juego mas famoso del mundo, videojuegos populares, Noticias de videojuegos, curiosidades de videojuegos, Últimas novedades en videojuegos": "video games that are, decision-making PC games, types of video games, most famous video games, genres of video games, what is the most famous game in the world, popular video games, video game news, video game curiosities, latest developments in video games"}`
/>
<link rel='canonical' href={canonicalURL} />
<link rel='alternate' hrefLang='es' href={`https://www.hypergamerx.com/es${pathname}`} />
<link rel='alternate' hrefLang='en' href={`https://www.hypergamerx.com/en${pathname}`} />
<meta http-equiv='Content-Language' content={lang} />
<meta name='viewport' content='width=device-width,initial-scale=1' />
<meta name='creator' content={autor} />
<meta name='publisher' content={autor} />
<meta name='robots' content='index, follow' />
<meta name='googlebot' content='index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1' />
<meta name='format-detection' content='telephone=no, address=no, email=no' />
<meta property='article:published_time' content={publishtime} />
<meta property='article:modified_time' content={updatetime} />
<meta property='article:author' content={autor} />

<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<link rel='mask-icon' href='/favicon.svg/' color='#8D46E7' />
<meta property='og:type' content={type} />
<meta property='og:url' content={Astro.url} />
<meta property='og:title' content={title} />
<meta property='og:locale' content={lang} />
<meta property='og:site_name' content='HyperGamerX' />
<meta property='og:description' content={description} />
<meta
  property='og:image'
  content={image && image.length > 4
    ? `https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/${image}`
    : '/logo4.png'}
/>
<meta property='og:image:alt' content={title} />

<meta property='twitter:card' content='summary_large_image' />
<meta property='twitter:url' content={Astro.url} />
<meta property='twitter:site' content='HyperGamerX' />
<meta property='twitter:title' content={title} />
<meta property='twitter:description' content={description} />
<meta
  property='twitter:image'
  content={image && image.length > 4
    ? `https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/${image}`
    : '/logo4.png'}
/>
<meta property='twitter:image:alt' content={title} />
