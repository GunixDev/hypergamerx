---
import { ChevronsLeft, ChevronLeft, ChevronRight, ChevronsRight } from "@lucide/astro";

interface Props {
  prevUrl?: string;
  nextUrl?: string;
  currentPage?: number;
  first?: string;
  last?: string;
}

const { prevUrl, nextUrl, currentPage, first, last } = Astro.props;

const showFirst = Boolean(first && prevUrl && first !== prevUrl);
const showPrev = Boolean(prevUrl);
const showNext = Boolean(nextUrl);
const showLast = Boolean(last && nextUrl && last !== nextUrl);
---

{
  (showPrev || showNext) && (
    <nav aria-label="Paginación" class="flex justify-center gap-2">
      {
        showFirst && (
          <a href={first} aria-label="Primera página" class="flex p-3 self-center justify-center items-center card-rounded bg-full-black text-full-white transition-colors hover:text-primary focus-visible:text-primary">
            <ChevronsLeft class="w-5 h-5 xl:w-7 xl:h-7" aria-hidden="true" />
          </a>
        )
      }

      {
        showPrev && (
          <a href={prevUrl} rel="prev"  aria-label="Página anterior" class="flex p-3 self-center justify-center items-center card-rounded bg-full-black text-full-white transition-colors hover:text-primary focus-visible:text-primary">
            <ChevronLeft class="w-5 h-5 xl:w-7 xl:h-7" aria-hidden="true" />
          </a>
        )
      }

      {
        currentPage && (
          <span aria-current="page" class="flex p-3 card-rounded bg-neutral-950">
            <span class="w-5 h-5 xl:w-7 xl:h-7 text-center font-bold max-sm:text-xs text-primary">
              <span class="sr-only">Página </span>
              {currentPage}
            </span>
          </span>
        )
      }

      {
        showNext && (
          <a href={nextUrl} rel="next" aria-label="Siguiente página" class="flex p-3 self-center justify-center items-center card-rounded bg-full-black text-full-white transition-colors hover:text-primary focus-visible:text-primary">
            <ChevronRight class="w-5 h-5 xl:w-7 xl:h-7" aria-hidden="true" />
          </a>
        )
      }

      {
        showLast && (
          <a href={last} aria-label="Última página" class="flex p-3 self-center justify-center items-center card-rounded bg-full-black text-full-white transition-colors hover:text-primary focus-visible:text-primary">
            <ChevronsRight class="w-5 h-5 xl:w-7 xl:h-7" aria-hidden="true" />
          </a>
        )
      }
    </nav>
  )
}