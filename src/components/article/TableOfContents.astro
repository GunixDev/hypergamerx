---
import type { TocItem } from "@src/utils/article-toc";

interface Props {
  data: TocItem[];
}

const { data } = Astro.props;
---

{
  data.length > 0 && (
    <nav aria-labelledby="toc-heading" class="flex flex-col items-start gap-2 self-stretch bg-full-black text-full-white px-6 py-4 my-4 card-rounded">
      <p id="toc-heading" class="text-xl font-bold">
        Índice del artículo
      </p>

      <ol class="flex flex-col items-start gap-1 self-stretch w-full">
        {data.map((indice) => (
          <li class:list={["w-full", indice.depth === 3 && "pl-4", indice.depth === 4 && "pl-8", ]}>
            <a href={`#${indice.slug}`} class:list={["inline-block py-0.5 transition-colors", indice.depth === 2 && "text-lg font-bold", indice.depth === 3 && "text-base", indice.depth === 4 && "text-sm text-muted",]}>
              {indice.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}