---
type Section = "guias" | "noticias" | "info" | "analisis" | "tops";

interface Props {
  gameSlug: string;
  active: Section;
  availableSections: Set<Section>;
}

const { gameSlug, active, availableSections } = Astro.props;

const sections: { id: Section; label: string; path: string }[] = [
  { id: "info", label: "Info", path: `/juegos/${gameSlug}` },
  { id: "analisis", label: "Análisis", path: `/juegos/${gameSlug}/analisis/1` },
  { id: "noticias", label: "Noticias", path: `/juegos/${gameSlug}/noticias/1` },
  { id: "guias", label: "Guías", path: `/juegos/${gameSlug}/guias/1` },
  { id: "tops", label: "Tops", path: `/juegos/${gameSlug}/tops/1` },
];

const visibleSections = sections.filter((section) => availableSections.has(section.id));
---

{
  visibleSections.length > 0 && (
    <nav aria-label="Secciones del juego">
      <ul class="flex flex-wrap items-center gap-2">
        {visibleSections.map((section) => {
          const isActive = section.id === active;
          return (
            <li>
              <a href={section.path} aria-current={isActive ? "page" : undefined} class:list={["inline-flex items-center px-3 py-2 border font-bold uppercase card-rounded transition-colors focus-visible:outline-2 focus-visible:outline-primary", isActive ? "bg-full-white text-full-black" : "bg-full-black text-full-white border-full-white hover:text-shadow-primary focus-visible:text-primary",]}>
                {section.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}