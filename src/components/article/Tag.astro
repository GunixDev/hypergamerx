---
import { getTerm, type TaxonomyTerm } from "emdash";

interface Props {
  tag: TaxonomyTerm;
}

const { tag } = Astro.props;

const term = !tag.description ? await getTerm("category", tag.slug, { locale: tag.locale, includeCounts: false }) : null;

const description = tag.description ?? term?.description;
const href = `/${tag.slug}/1`;
---

<a
  href={href}
  aria-label={description && description !== tag.label ? `${tag.label}: ${description}` : undefined}
  class="inline-flex justify-center items-center card-rounded font-xs px-2 md:px-2.5 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-primary bg-full-black text-full-white hover:text-primary focus-visible:text-primary"
>
  {tag.label}
</a>
