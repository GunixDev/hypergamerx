---
import Twitter from "@public/logos/twitter.svg";
import Reddit from "@public/logos/reddit.svg";
import Whatsapp from "@public/logos/whatsapp.svg";
import Facebook from "@public/logos/facebook.svg";
import Email from "@public/logos/email.svg";
import Flipboard from "@public/logos/flipboard.svg";

interface Props {
  path: string;
  title: string;
}

const { path, title } = Astro.props;

const cleanPath = path.startsWith("/") ? path : `/${path}`;
const url = `https://hypergamerx.com${cleanPath}`;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const shareText = encodeURIComponent(`⭐ ${title} - HyperGamerX 🎮`);
const emailSubject = encodeURIComponent(`⭐ Mira este artículo en HyperGamerX: ${title}`);
const emailBody = encodeURIComponent(`Te comparto este artículo de HyperGamerX:\n\n${title}\n${url}`);

const links = [
  {
    name: "Compartir en X (Twitter)",
    href: `https://twitter.com/intent/tweet?text=${shareText}&url=${encodedUrl}`,
    Icon: Twitter,
    external: true,
  },
  {
    name: "Compartir en Reddit",
    href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
    Icon: Reddit,
    external: true,
  },
  {
    name: "Compartir en WhatsApp",
    href: `https://api.whatsapp.com/send?text=${shareText}%20${encodedUrl}`,
    Icon: Whatsapp,
    external: true,
  },
  {
    name: "Compartir en Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    Icon: Facebook,
    external: true,
  },
  {
    name: "Compartir por correo electrónico",
    href: `mailto:?subject=${emailSubject}&body=${emailBody}`,
    Icon: Email,
    external: false,
  },
  {
    name: "Compartir en Flipboard",
    href: `https://share.flipboard.com/bookmarklet/popout?v=2&url=${encodedUrl}&title=${encodedTitle}`,
    Icon: Flipboard,
    external: true,
  },
];
---

<div role="group" aria-label="Compartir artículo" class="flex justify-center items-center gap-1 ml-auto">
  {
    links.map(({ name, href, Icon, external }) => (
      <a href={href} aria-label={name} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="p-1 rounded hover:opacity-80 focus-visible:outline-2 focus-visible:outline-primary transition-opacity">
        <Icon class="card-rounded w-5 h-5 md:w-6 md:h-6 lg:w-8 lg:h-8" aria-hidden="true" />
      </a>
    ))
  }
</div>