---
import ArticulosRamdon from '../components/ArticulosRamdon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LayoutPrincipal from '../layouts/LayoutPrincipal.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', (data) => {
  return data.data.isDraft !== true && data.slug.startsWith('en');
});

allPosts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});
allPosts.length = 8;
---

<LayoutPrincipal>
  <div class='sm:grid sm:grid-cols-11 sm:gap-4 ls:max-md:mt-16'>
    <div class='sm:col-span-7 relative mx-12 sm:mx-6 sm:text-lg ls:max-sm:mb-4'>
      <h1 class='sm:text-5xl text-4xl font-bold my-3 sm:my-6'>Welcome to HyperGamerX!</h1>
      <p>
        Hey, how are you gamer! I knew that HyperGamerX is like paradise for all video game fans, and you will love it!
        discover everything we have for you, from breaking news to reviews of games
      </p><br />
      <p>
        Imagine a place where you find out about all the latest news from your favorite games, whether it's Minecraft,
        Geometry Dash, Fortnite, among others. Well, that's what HyperGamerX offers you. From epic releases to exciting
        events, here we keep you in the loop of everything that's happening in the world of video games.
      </p><br />
      <p>
        Are you stuck on that tricky level? Do you need some tips to shine in your games? At HyperGamerX you have
        detailed guides and tricks that will make you the king of protips and you can beat your friends.
      </p><br />
      <p>
        Our reviews are like those conversations with friends where everyone gives their honest opinion. We analyze each
        game from top to bottom, from gameplay to graphics and plot, so you have all the info you need before you go on
        the adventure.
      </p><br />
      <p>
        At HyperGamerX we don't just talk about video games, we live them with passion! We understand the fire you feel
        for gaming, because we feel it too. So, join our
        <a href={'https://discord.gg/aXmCVfcXaa'} hreflang={'en'} target='_blank' class='text-blue-600'> Discord</a>,
        where we all share that unique excitement for video games and share opinions among them, you can also find
        people to play with, soon we will do events among our community, with great prizes!
      </p>
      <p>
        <br />
        Don't miss a single detail on this amazing journey. Ready to dive in? Visit HyperGamerX today and live the ultimate
        experience for true video game fans. We'll be waiting for you with the controls ready! 🎮✨
      </p>
    </div>
    <div class='h-full ls:max-sm:w-full relative sm:col-span-4'>
      <div
        class={`bg-slate-950 mb-1 md:p-5 ls:max-md:p-3 rounded-2xl md:mt-10 
         w-11/12 mx-auto`}>
        <h2 class='md:text-lg font-bold ls:max-md:text-base text-white'>Recent articles</h2>
        {allPosts.map((post) => <ArticulosRamdon file={post.slug} data={post.data} lang={'en'} />)}
      </div>
    </div>
  </div>
</LayoutPrincipal>
