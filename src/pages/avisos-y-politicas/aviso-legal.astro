---
import Layout from "@layouts/Layout.astro";
import ShowMore from "@components/ui/ShowMore.astro";
import { getEmDashCollection } from "emdash";
import Card from "@components/ui/Card.astro";

const { entries: recentPosts, error } = await getEmDashCollection("posts", {
  status: "published",
  orderBy: { published_at: "desc" },
  limit: 8,
});

if (error) {
  console.error("Error al obtener artículos recientes:", error);
  throw new Error("No se pudieron cargar los artículos recientes.");
}
---

<Layout robots="noindex, nofollow" class="pt-5 md:pt-8 lg:pt-11 xl:pt-16 pb-5 md:pb-8 lg:pb-11 xl:pb-16 pl-2 md:pl-12 lg:pl-10 xl:pl-14 pr-2 md:pr-12 lg:pr-10 xl:pr-14 gap-4 items-start content-start flex lg:grid lg:grid-cols-12">
