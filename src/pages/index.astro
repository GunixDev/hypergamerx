---
import Layout from "@layouts/Layout.astro";
import ShowMore from "@components/ui/ShowMore.astro";
import Card from "@components/ui/Card.astro";
import { gestPosts } from "@src/utils/article-toc";

const [recentPosts, newsPosts, guidesPosts, curiositiesPosts] =
  await Promise.all([
    gestPosts(9, Astro.cache),
    gestPosts(12, Astro.cache, { primary_category: "noticias" }),
    gestPosts(12, Astro.cache, { primary_category: "guias" }),
    gestPosts(12, Astro.cache, { category: "curiosidades" }),
  ]);

const lastPost = recentPosts[0];
---

<Layout>
  <h1 class="w-full hidden">HyperGamerX</h1>
  <div class="flex flex-col items-start gap-2 self-stretch">
    <div class="flex flex-col items-start gap-2 self-stretch">
      <ShowMore
        heading={true}
        title={"Artículos Recientes"}
        pahtto={`/blog/pagina/1`}
      />

      <div class="xl:grid xl:grid-cols-2 items-start gap-3 w-full">
        <Card modo="main" post={lastPost} heading="h3" loading="eager" />
        <div class="hidden xl:grid grid-rows-2 h-full items-start flex-[1 0 0] self-stretch">
          {recentPosts.slice(1, 3).map((post) => (
            <Card modo="list" post={post} heading="h3" loading="eager" />
          ))}
        </div>
      </div>
    </div>
    <div class="flex xl:hidden flex-col items-start gap-2 self-stretch">
      {recentPosts.slice(1, 9).map((post) => (
        <Card modo="list" post={post} loading={"eager"} heading="h3" />
      ))}
    </div>
    <div class="hidden xl:grid xl:grid-cols-2 items-start gap-2 self-stretch">
      {recentPosts.slice(3, 9).map((post) => (
        <Card modo="list" post={post} heading="h3" />
      ))}
    </div>
  </div>

  <div class="flex flex-col items-start gap-2 self-stretch">
    <ShowMore
      heading={true}
      title={"Noticias Recientes"}
      pahtto={`/noticias/1`}
    />
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 items-start content-start gap-3 self-stretch">
      {newsPosts.map((post) => (
        <Card modo="card" post={post} heading="h3" />
      ))}
    </div>
  </div>

  <div class="flex flex-col items-start gap-2 self-stretch">
    <ShowMore heading={true} title={"Guías Recientes"} pahtto={`/guias/1`} />
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 items-start content-start gap-3 self-stretch">
      {guidesPosts.map((post) => (
        <Card modo="card" post={post} heading="h3" />
      ))}
    </div>
  </div>

  <div class="flex flex-col items-start gap-2 self-stretch">
    <ShowMore
      heading={true}
      title={"Curiosidades Recientes"}
      pahtto={`/curiosidades/1`}
    />
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 items-start content-start gap-3 self-stretch">
      {curiositiesPosts.map((post) => (
        <Card modo="card" post={post} heading="h3" />
      ))}
    </div>
  </div>
</Layout>
