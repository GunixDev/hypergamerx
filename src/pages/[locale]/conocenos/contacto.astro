---
export const prerender = false
import Layout from "../../../layouts/Layout.astro";
import type {Locale} from "../../../types";
import {useTranslations} from "../../../i18n/utils";
import {actions} from "astro:actions";

const { locale } = Astro.params;

if( locale != 'es' && locale != 'en') {
  return Astro.redirect('/es/');
}

const result = Astro.getActionResult(actions.send);
if (result && !result.error) {
  return Astro.redirect(`/${locale}/`);
}

const t = useTranslations(locale);

---
<Layout>
  <main class="flex mx-2 flex-col items-start gap-6 xl:gap-12 self-stretch">
    <div class="flex flex-col items-start gap-1.5 self-stretch">
      <h1 class="font-heading1 mx-auto">{t("contacto.title")}</h1>
      <p class="font-sm">{t("contacto.description")}</p>
    </div>
    <form method="post" action={actions.send} class="flex flex-col items-start gap-1.5 xl:gap-2 self-stretch">
      <label for="name" class="font-sm">{t("contact.form.name")}</label>
      <input type="text" id="name" name="name" class="flex px-1 py-2 flex-col items-start gap-2.5 self-stretch rounded border-neutral-400 bg-neutral-50 text-neutral-950 border-2 invalid:text-red-500 invalid:border-red-500 font-xs" placeholder={t("contact.input.name.value")} required>

      <label for="email" class="font-sm">{t("contact.form.email")}</label>
      <input type="email" id="email" name="email" class="flex px-1 py-2 flex-col items-start gap-2.5 self-stretch rounded border-neutral-400 bg-neutral-50 text-neutral-950 border-2 invalid:text-red-500 invalid:border-red-500 font-xs" placeholder={t("contact.input.email.value")}required>

      <label for="subject" class="font-sm">{t("contact.form.subject")}</label>
      <input type="text" id="subject" name="subject" class="flex px-1 py-2 flex-col items-start gap-2.5 self-stretch rounded border-neutral-400 bg-neutral-50 text-neutral-950 border-2 invalid:text-red-500 invalid:border-red-500 font-xs" minlength="15" maxlength="500" placeholder={t("contact.form.subject")} required>

      <label for="message" class="font-sm">{t("contact.form.message")}</label>
      <textarea id="message" name="message" class="flex min-h-24 max-h-40 px-2 py-1 flex-col items-start gap-2.5 w-full bg-neutral-50 text-neutral-950 rounded border-2 border-neutral-400 font-xs" placeholder={t("contact.form.message")} required></textarea>

      <button type="submit" class="flex px-2.5 py-2 justify-center items-center gap-2.5 w-full bg-neutral-950 text-neutral-50 rounded">{t("contact.form.send")}</button>
    </form>

  </main>
</Layout>
