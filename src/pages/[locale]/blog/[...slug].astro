---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import LayoutPrincipal from '../../../layouts/LayoutPrincipal.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Indice from '../../../components/Indice.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import ArticulosRamdon from '../../../components/ArticulosRamdon.astro';
import Estrellas from '../../../components/Estrellas.astro';
import Iframeop from '../../../components/util/Iframeop';

export async function getStaticPaths() {
  const pages = await getCollection('blog');
  const paths = pages.map((page) => {
    const [locale, ...slug] = page.slug.split('/');
    return { params: { locale, slug: slug.join('/') || undefined }, props: page };
  });
  return paths;
}
const { locale, slug } = Astro.params;
let lang2 = getLangFromUrl(Astro.url);
const page = Astro.props;

const renderResult = await page?.render();
const Content = renderResult?.Content;
let resena: undefined | boolean;
let games: any;

if (page.data.videojuego) {
  games = await getEntry('videogames', page.data.videojuego[0]?.slug);
}

if (page.data?.genero.includes('resena') && page.data?.videojuego) {
  resena = true;
  games = await getEntry('videogames', page.data?.videojuego[0]?.slug);
}
const t = useTranslations(lang2);

const allPosts = await getCollection('blog', (data) => {
  return (
    data.slug !== slug &&
    data.data.isDraft !== true &&
    data.slug.startsWith(lang2) &&
    data.data.title !== page.data.title
  );
});

allPosts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

let game = page.data.videojuego && page.data.videojuego[0]?.slug;
const gamesposts = allPosts.filter((post) => {
  return post.data.videojuego && post.data.videojuego[0]?.slug === game;
});
let postgames = false;
if (gamesposts.length >= 3) {
  gamesposts.sort((a, b) => {
    return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
  });
  postgames = true;
  gamesposts.length = 3;
}

allPosts.length = 5;
---

<LayoutPrincipal
  title={page.data.title}
  description={page.data.description}
  image={page.data.image}
  autor={page.data.author}
  keywords={page.data.keywords}
  type='article'
  spanish={`https://www.hypergamerx.com/es/blog/${page.slug.slice(3)}/`}
  english={`https://www.hypergamerx.com/en/blog/${page.slug.slice(3)}/`}>
  <div class='lg:w-11/12 w-[99%] md:m-auto my-8 mt-12 sm:my-10'>
    <div class='sm:grid sm:grid-cols-7 sm:gap-4'>
      <div class='sm:col-span-5 relative mx-2 sm:mx-4'>
        <h1 class='md:text-5xl md:mt-10 text-slate-400 font-bold work ls:max-sm:text-lg sm:max-md:text-xl'>
          {page.data.title}
        </h1>
        <div class='md:my-2 ls:max-md:my-0 text-slate-700'>
          <p class='text-gray-300 text-xs md:text-sm lg:max-md:text-xs font-extralight md:font-normal'>
            {t('article.creadorpor')}
            <strong>{page.data.author}</strong>
            {t('article.eldiade')}
            <span>
              <FormattedDate date={page.data.pubDate} lang={locale} />
              {
                page.data.updatedDate ? (
                  <span class=' opacity-70'>
                    {' '}
                    ({t('article.ultimaactualizacion')}: <FormattedDate date={page.data.updatedDate} lang={locale} />)
                  </span>
                ) : null
              }
            </span>
          </p>
        </div>
        <p class='text-xs my-1 md:text-sm md:my-2 text-slate-400'>
          {
            page.data.genero.map((gen: any) => {
              if (gen === 'resena') {
                return t('article.resenadevieojuego');
              } else if (gen === 'guia') {
                return t('article.guia');
              } else if (gen === 'noticia') {
                return t('article.noticia');
              } else if (gen === 'curiosidades') {
                return t('article.curiosidades');
              } else {
                return null;
              }
            })
          }
        </p>
        <p class='text-xs md:text-xl text-gray-400'>{page.data.description}</p>

        {
          resena && games?.data.Trailervideo ? (
            <Iframeop id={games.data.Trailervideo} client:load/>

          ) : page && page.data.image && page.data.image !== null ? (
          <img
              src={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_479/${page.data.image}`}
              srcset={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_160/${page.data.image} 256w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_319/${page.data.image} 512w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_479/${page.data.image} 768w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_639/${page.data.image} 1024w,
          https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_958/${page.data.image} 1280w`}
              width='479'
              height='270'
              alt={page.data.image}
              class='my-8 w-full h-auto mx-auto'
            />
          ) : null
        }

        <div class='bg-slate-950 md:p-6 ls:max-md:p-4 rounded-2xl w-fit mt-4 ls:max-sm:hidden'>
          <Indice data={renderResult?.headings} lang={lang2} />
        </div>
        <div class='contenido'>
          <Content />
        </div>
      </div>
      <div class='h-full ls:max-sm:w-full relative sm:col-span-2'>
        <div
          class={`h-full relative sm:col-span-2 ${
            resena ? 'ls:max-sm:grid ls:max-sm:grid-cols-5 ls:max-sm:p-2 ls:max-sm:gap-1' : ''
          }`}>
          {
            resena && (
              <div class='bg-slate-950 p-2 md:p-4 rounded-2xl w-full h-fit ls:max-sm:col-span-3'>
                <p class='text-sm text-slate-400 text-center font-bold md:text-xl xl:text-2xl'>{games.data.name}</p>

                <img
  src={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_186/${games.data.CoverImage}`}
  srcset={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_62/${games.data.CoverImage} 256w,
  https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_124/${games.data.CoverImage} 512w,
  https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_186/${games.data.CoverImage} 768w,
  https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_248/${games.data.CoverImage} 1024w,
https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_310/${games.data.CoverImage} 1280w`}
  width='186'
  height='230'
  alt={games.data.name}
  decoding='async'
  loading='lazy'
  class='my-1 sm:my-4 w-80 h-56 md:h-64 lg:h-96 mx-auto object-cover'
/>

                <Estrellas cantidad={games.data.stars} />
                <p class='ml-1 lg:ml-3 text-xs lg:text-base text-slate-300'>
                  {t('article.lanzamiento')}:{' '}
                  <span class='text-slate-400 text-xs sm:text-base'>
                    {<FormattedDate date={games.data.DateLaunch} lang={locale} />}
                  </span>
                </p>
                <p class='ml-1 lg:ml-3 text-xs lg:text-base text-slate-300'>
                  {t('article.multijugador')}:
                  <span class='text-slate-400'>{games.data.Multijugador ? t('article.yes') : t('article.no')}</span>
                </p>
                <p class='ml-1 lg:ml-3 text-xs lg:text-base text-slate-300 hover:text-slate-100 duration-300'>
                  {resena && games?.data.Trailervideo ? (
                    <a target='_blank' href={games.data.Trailervideo}>
                      {t('article.vertrailer')}{' '}
                    </a>
                    <img
                        width={12}
                        height={12}
                        src='/icons/external.svg'
                        class='align-middle mx-1 inline-block'
                        alt='External'
                      />
                  ) : null}
                </p>
              </div>
            )
          }
          <div
            class={`bg-slate-950 mb-1 md:p-5 ls:max-md:p-3 rounded-2xl md:mt-10 ${
              resena ? 'ls:max-sm:col-span-2' : ' w-11/12 mx-auto'
            }`}>
            <h2 class='md:text-lg font-bold ls:max-md:text-base text-white'>{t('article.articuclosreciente')}</h2>
            {allPosts.map((post) => <ArticulosRamdon file={post.slug} data={post.data} lang={lang2} />)}
          </div>
          {
            postgames && (
              <div
                class={`bg-slate-950 md:p-5 ls:max-md:p-3 rounded-2xl ${
                  resena ? ' ls:max-sm:col-span-6' : ' w-11/12 mx-auto'
                }`}>
                <h2 class='md:text-lg font-bold ls:max-md:text-base text-white'>
                  {t('article.articulosde')} {games.data.name}
                </h2>
                {gamesposts.map((post) => (
                  <ArticulosRamdon file={post.slug} data={post.data} lang={lang2} />
                ))}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</LayoutPrincipal>
