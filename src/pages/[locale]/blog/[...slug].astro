---
import { getCollection, getEntry } from 'astro:content';
import type { Locale, Blog, TagsJsonArray, GameJsonArray, AuthorsJsonArray } from '@/types';
import { amazon } from '@components/utils/blog/Amazon';
import LayoutPrincipal from '@layouts/LayoutPrincipal.astro';
import FormattedDate from '@components/utils/FormattedDate.astro';
import Indice from '@components/utils/Indice.astro';
import { useTranslations } from '@i18n/utils';
import Iframeop from '@components/utils/blog/Iframeop';
import { GetGames, GetTags, GetAuthor } from '@components/utils/blog/GetContent';
import AsideBlog from '@components/utils/blog/AsideBlog';
import Compartir from '@components/utils/blog/Compartir';

export async function getStaticPaths() {
  let pages = await getCollection('blog', (data) => {
    return data?.data?.IsType === 'Complete';
  });
  const paths = pages.map((page) => {
    const [locale, ...slug] = page.slug.split('/');
    return { params: { locale: locale as unknown as Locale, slug: slug.join('/') || undefined } };
  });
  return paths;
}

const { locale, slug } = Astro.params;
const page = (await getEntry('blog', locale + '/' + slug)) as unknown as Blog;
const renderResult = await page.render();
const Content = renderResult.Content;
const t = useTranslations(locale);
let resena: undefined | boolean;
let games: GameJsonArray = [];
let tags: TagsJsonArray = [];
let author: AuthorsJsonArray = [];

if (Array.isArray(page?.data?.Videojuego)) {
  games = await GetGames(page.data?.Videojuego);
}
if (Array.isArray(page?.data?.Tags)) {
  tags = await GetTags(page.data?.Tags);
}
if (Array.isArray(page?.data?.Authors)) {
  author = await GetAuthor(page.data?.Authors);
}

tags.map((tag: any) => {
  if (tag.id === 'reseña') {
    resena = true;
  }
});

const allPosts = await getCollection('blog', (data) => {
  return (
    data?.slug !== slug &&
    data?.data?.IsType === 'Complete' &&
    data?.slug.startsWith(locale) &&
    data?.data?.Title !== page.data?.Title
  );
}).then((posts) => {
  posts.sort((a, b) => {
    return new Date(b.data?.PubDate).getTime() - new Date(a.data?.PubDate).getTime();
  });
  return posts;
});

const gamesposts = allPosts.filter((post) => {
  const postVideojuego = post?.data?.Videojuego;
  if (!postVideojuego || !games[0] || !games[0].id) {
    return false;
  }
  return postVideojuego[0]?.id === games[0].id;
});

let postgames = false;
if (gamesposts.length >= 3) {
  gamesposts.sort((a, b) => {
    return new Date(b.data?.PubDate).getTime() - new Date(a.data?.PubDate).getTime();
  });
  postgames = true;
  gamesposts.length = 3;
}

allPosts.length = 5;
let amazonlocale: any = amazon[locale];
let amazon1 = amazonlocale[games[0]?.id ? games[0]?.id : "games['minecraft'].slug"];
if (amazon1 === undefined) {
  amazon1 = null;
}
---

<LayoutPrincipal
  title={page.data?.Title}
  description={page.data?.Description}
  image={page.data?.ImageCover}
  autor={'HyperGamerX'}
  keywords={page.data?.Keywords}
  type='article'>
  <div class='sm:grid sm:grid-cols-11 sm:gap-2 md:gap-6 lg:gap-12'>
    <main lang={locale} class='sm:col-span-7 relative'>
      <h1 class='work subtitulo3-movil lgi:subtitulo2-movil lss:subtitulo3-desktop lg:titulo-desktop'>
        {page.data?.Title}
      </h1>
      <p class='small-movil lgi:my-2 lss:normal-movil lg:normal-desktop'>{page.data?.Description}</p>
      <p class='smaller-movil lss:smallerb-movil lg:minismaller-desktop my-1 lss:my-2 gap-1 text-white flex'>
        {
          tags.map((tag: any) => (
            <span class='md:px-2 md:py-1 px-1 py-0.5 bg-black' title={locale === 'es' ? tag.Spanish : tag.English}>
              {locale === 'es' ? tag.Name : tag.NameEnglish}
            </span>
          ))
        }
      </p>
      <div class='grid grid-rows-2 gap-0.5 lgi:mt-1 lss:mt-2'>
        <div class='flex'>
          <img src='/icons/SendPage.svg' alt='Pagina enviada' class='w-4 h-4 my-auto' /><span
            class='ml-1 my-auto smaller-movil lss:small-movil lg:small-desktop'
            >{t('article.creadorpor')}
            <FormattedDate date={page.data?.PubDate} locale={locale} /></span
          >
        </div>
        {
          page.data?.UpdatedDate && (
            <div class='flex'>
              <>
                <img src='/icons/UpdatePage.svg' alt='Pagina actualizada' class='w-4 h-4 my-auto' />
                <span class='ml-1 my-auto smaller-movil lss:small-movil lg:small-desktop'>
                  {t('article.ultimaactualizacion')}
                  <FormattedDate date={page.data?.UpdatedDate} locale={locale} />
                </span>
              </>
            </div>
          )
        }
      </div>
      <div class='grid grid-cols-2'>
        <div>
          <span class='smaller-movil lgi:smallerb-movil lg:small-desktop'>{t('articulo.escritores')}: </span>
          <div class='grid-flow-row-dense grid'>
            {
              author.map((author: any) => (
                <div class='flex'>
                  <img
                    class=' rounded-2xl w-[16px] h-[16px] lgi:w-[24px] lgi:h-[24px]'
                    src='/Profiles/Brayan-Cordova.png'
                    alt='author imagen'
                  />
                  <span class='minismaller-movil lgi:smaller-movil lg:minismall-desktop my-auto ml-1'>
                    {author.Name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div class='place-content-end place-self-end'>
          {(<Compartir locale={locale} path={page.slug.slice(3)} />)}
        </div>
      </div>

      {
        resena && games[0].TrailerVideo ? (
          <Iframeop client:load id={games[0].TrailerVideo} />
        ) : page && page.data?.ImageCover && page.data?.ImageCover !== null && page.data?.ImageCover.trim() !== '' ? (
          <img
            src={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_479/${page.data?.ImageCover}`}
            srcset={`https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_160/${page.data?.ImageCover} 256w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_319/${page.data?.ImageCover} 512w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_479/${page.data?.ImageCover} 768w,
                https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_639/${page.data?.ImageCover} 1024w,
          https://res.cloudinary.com/de4wvqywn/image/upload/f_webp/q_auto/c_scale,w_958/${page.data?.ImageCover} 1280w`}
            width='479'
            height='270'
            alt={page.data?.ImageCover}
            class='my-8 w-full h-auto mx-auto rounded-md'
          />
        ) : (
          <img
            src={`/Banner.png`}
            width='479'
            height='270'
            alt={'Imagen de HyperGamerX'}
            class='my-8 w-full h-auto mx-auto rounded-md'
          />
        )
      }
      <div class='bg-black text-white rounded-xl md:px-8 md:py-2 ls:max-md:p-4 w-fit mt-4 ls:max-sm:hidden'>
        <Indice data={renderResult?.headings} locale={locale} />
      </div>
      <div class='contenido'>
        <Content />
      </div>
    </main>
    <AsideBlog
      locale={locale}
      resena={resena}
      games={games}
      allPosts={allPosts}
      gamesposts={gamesposts}
      postgames={postgames}
      amazon1={amazon1}
    />
  </div>
</LayoutPrincipal>
