---
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  return [{params: {locale: "en"}}, {params: {locale: "es"}}];
}
---
<script src="/pagefind/pagefind-ui.js" is:inline/>
<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
<Layout>
  <div id="search"></div>
</Layout>
<script is:inline>
  window.addEventListener('DOMContentLoaded', (event) => {
    new PagefindUI({element: "#search", pageSize: 10, showSubResults: false, showImages: false, autofocus: false, debounceTimeoutMs: 300, resetStyles: true, showEmptyFilters: false});
  });
</script>
