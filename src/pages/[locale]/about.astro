---
import ArticulosRamdon from '../../components/Views/ArticulosRamdon.astro';
import { getLangFromUrl, useTranslations, useTranslationsSpecial } from '../../i18n/utils';
import LayoutPrincipal from '../../layouts/LayoutPrincipal.astro';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const te = useTranslationsSpecial(lang);
const t = useTranslations(lang);

export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'es' } }];
}

const allPosts = await getCollection('blog', (data) => {
  return data?.data?.IsDraft !== true && data?.slug.startsWith(lang);
});

allPosts.sort((a, b) => {
  return new Date(b.data?.PubDate).getTime() - new Date(a.data?.PubDate).getTime();
});
allPosts.length = 8;
---

<LayoutPrincipal>
  <div class='sm:grid sm:grid-cols-11 sm:gap-4 ls:max-md:mt-16'>
    <div class='sm:col-span-7 relative mx-12 sm:mx-6 sm:text-lg ls:max-sm:mb-4'>
      <h1 class='sm:text-5xl text-4xl font-bold my-3 sm:my-6'>{te('about.title')}</h1>
      <p>
        {te('about.1')}
      </p><br />
      <p>
        {te('about.2')}
      </p><br />
      <p>
        {te('about.3')}
      </p><br />
      <p>
        {te('about.4')}
      </p><br />
      <p>
        {te('about.5')}
        <a href={'https://discord.gg/aXmCVfcXaa'} hreflang={lang} target='_blank' class='text-blue-600'> Discord</a>{
          te('about.6')
        }
      </p>
      <p>
        <br />
        {te('about.7')}
      </p>
    </div>
    <div class='h-full ls:max-sm:w-full relative sm:col-span-4'>
      <div
        class={`bg-slate-950 mb-1 md:p-5 ls:max-md:p-3 rounded-2xl md:mt-10 
         w-11/12 mx-auto`}>
        <h2 class='md:text-lg font-bold ls:max-md:text-base text-white'>{t('article.articuclosreciente')}</h2>
        {allPosts.map((post) => <ArticulosRamdon file={post.slug} data={post.data} locale={lang} />)}
      </div>
    </div>
  </div>
</LayoutPrincipal>
