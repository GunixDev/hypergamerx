---
import ArticulosRamdon from '@components/Views/ArticulosRamdon.astro';
import { getLangFromUrl, useTranslations, useTranslationsSpecial } from '@i18n/utils';
import LayoutPrincipal from '@layouts/LayoutPrincipal.astro';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const te = useTranslationsSpecial(lang);
const t = useTranslations(lang);

export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'es' } }];
}

const allPosts = await getCollection('blog', (data) => {
  return data?.data?.IsType === 'Complete' && data?.slug.startsWith(lang);
}).then((posts) => {
  posts.sort((a, b) => {
    return new Date(b.data?.PubDate).getTime() - new Date(a.data?.PubDate).getTime();
  });
  return posts;
});

allPosts.length = 8;
---

<LayoutPrincipal>
  <div class='sm:grid sm:grid-cols-11 sm:gap-4'>
    <div class='small-movil lss:normal-movil lg:normal-desktop sm:col-span-7 relative'>
      <h1 class='subtitulo1-movil lss:titulo-movil lg:titulo-desktop mb-4'>{te('about.title')}</h1>
      <p>
        {te('about.1')}
      </p><br />
      <p>
        {te('about.2')}
      </p><br />
      <p>
        {te('about.3')}
      </p><br />
      <p>
        {te('about.4')}
      </p><br />
      <p>
        {te('about.5')}
        <a href={'https://discord.gg/aXmCVfcXaa'} hreflang={lang} target='_blank' class='text-blue'> Discord</a>{
          te('about.6')
        }
      </p>
      <p>
        <br />
        {te('about.7')}
      </p>
    </div>
    <div class='mx-auto ls:max-sm:w-full relative sm:col-span-4 mt-10'>
      <div class={`rounded-2xl `}>
        <h2 class='subtitulo3-movil md:subtitulo4-movil lg:subtitulo4-desktop text-center mb-4'>
          {t('article.articuclosreciente')}
        </h2>
        <div class='grid grid-cols-1 gap-2 sm:gap-3 lg:gap-4 mt-2 lg:mt-5'>
          {
            allPosts.map((post) => {
              const { slug, data } = post;
              return <ArticulosRamdon file={slug} data={data} locale={lang} />;
            })
          }
        </div>
      </div>
    </div>
  </div>
</LayoutPrincipal>
