---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import ArticulosView from '../../components/ArticulosView.astro';
import ArticulosView2 from '../../components/ArticulosView2.astro';
import ArticulosView3 from '../../components/ArticulosView3.astro';
import LayoutPrincipal from '../../layouts/LayoutPrincipal.astro';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'es' } }];
}

const allPosts = await getCollection('blog', (data) => {
  return data.data.isDraft !== true && data.slug.startsWith(lang);
});

allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const Ultimo = allPosts.slice(0, 1);
const recentpost = allPosts.slice(1, 4);
const newsPosts = allPosts.filter((post) => post.data.genero.includes('noticia')).slice(0, 8);
const curiosidadesPosts = allPosts.filter((post) => post.data.genero.includes('curiosidades')).slice(0, 4);
const resenasPosts = allPosts.filter((post) => post.data.genero.includes('resena')).slice(0, 4);
const minecraftPosts = allPosts
  .filter(
    (post) =>
      post.data.videojuego &&
      post.data.videojuego.some((videojuego: { slug: string }) =>
        ['minecraft-for-windows', 'minecraft-java-edition'].includes(videojuego.slug),
      ),
  )
  .slice(0, 4);

const geometryPosts = allPosts
  .filter(
    (post) =>
      post.data.videojuego &&
      post.data.videojuego.some((videojuego: { slug: string }) => ['geometry-dash'].includes(videojuego.slug)),
  )
  .slice(0, 8);

import Listdata from '../../components/util/listdata.astro';
---

<LayoutPrincipal>
  <main>
    <div class='w-11/12 mx-auto'>
      <h1 class='md:text-4xl text-base mx-auto font-bold mt-12 md:mt-2 text-white'>
        {t('index.articulosdevideojuego')}
      </h1>
      <h2 class='lg:text-3xl font-bold my-4'>{t('index.ultimoarticules')}</h2>
      <div class='grid grid-cols-5 h-auto lg:h-max-[384px] relative bg-slate-950'>
        <div class='col-span-3'>
          {Ultimo.map((post) => <ArticulosView2 file={post.slug} data={post.data} lang={lang} />)}
        </div>
        <div class='col-span-2 mx-2 lg:mx-4'>
          <div
            class='relative w-full h-auto my-1 md:my-3 md:p-1 group duration-500 grid grid-flow-row gap-2 lss:gap-2 sm:my-4 sm:gap-6 md:gap-7'>
            {recentpost.map((post) => <Listdata file={post.slug} data={post.data} lang={lang} />)}
          </div>
        </div>
      </div>
      <h2 class='lg:text-3xl font-bold mt-8 mb-4'>{t('index.noticianuevas')}</h2>
      <div class='grid grid-cols-4 lg:gap-4 gap-1 relative'>
        {newsPosts.map((post) => <ArticulosView file={post.slug} data={post.data} lang={lang} />)}
      </div>
      <h2 class='lg:text-3xl font-bold mt-8 mb-4'>{t('index.ultimascuriosidades')}</h2>
      <div class='grid grid-cols-4 lg:gap-4 gap-1 relative'>
        {curiosidadesPosts.map((post) => <ArticulosView file={post.slug} data={post.data} lang={lang} />)}
      </div>
      <h2 class='lg:text-3xl font-bold mt-8 mb-4'>{t('index.resenasvideogames')}</h2>
      <div class='grid grid-cols-4 lg:gap-4 gap-1 relative'>
        {resenasPosts.map((post) => <ArticulosView file={post.slug} data={post.data} lang={lang} />)}
      </div>
      <h2 class='lg:text-3xl font-bold mt-8 mb-4'>{t('index.articulosde')} Minecraft</h2>
      <div class='grid grid-cols-4 lg:gap-4 gap-1 relative'>
        {minecraftPosts.map((post) => <ArticulosView file={post.slug} data={post.data} lang={lang} />)}
      </div>
      <h2 class='lg:text-3xl font-bold mt-8 mb-4'>{t('index.articulosde')} Geometry Dash</h2>
      <div class='grid grid-cols-4 lg:gap-4 gap-1 relative'>
        {geometryPosts.map((post) => <ArticulosView file={post.slug} data={post.data} lang={lang} />)}
      </div>
    </div>
  </main>
</LayoutPrincipal>
