---
import ArticulosRamdon from "@components/Views/ArticulosRamdon.astro";
import {getLangFromUrl, useTranslations, useTranslationsSpecial} from "@i18n/utils";
import LayoutPrincipal from "@layouts/LayoutPrincipal.astro";
import {getCollection} from "astro:content";

export async function getStaticPaths() {
    return [{params: {locale: "en"}}, {params: {locale: "es"}}];
}

const lang = getLangFromUrl(Astro.url);

const allPosts = await getCollection("blog", (data) => {
    return data?.data?.IsType === "Complete" && data?.slug.startsWith(lang);
}).then((posts) => {
    posts.sort((a, b) => {
        return new Date(b.data?.PubDate).getTime() - new Date(a.data?.PubDate).getTime();
    });
    return posts;
});

const te = useTranslationsSpecial(lang);
const t = useTranslations(lang);
const newsPosts = allPosts.filter((post) => post.data?.Tags && post.data?.Tags.some((tag: any) => ["noticia"].includes(tag.id))).slice(0, 6);

allPosts.length = 8;
---

<LayoutPrincipal>
  <div class="sm:grid sm:grid-cols-11 sm:gap-4">
    <main class="small-movil lss:normal-movil lg:normal-desktop sm:col-span-7 relative">
      <h1 class="subtitulo1-movil text-center lss:titulo-movil lg:titulo-desktop mb-4">{te("cookie.1")}</h1>
      <section class="small-movil lss:normal-movil lg:normal-desktop sm:col-span-7 relative">
          {te("cookie.2")}
      </section>

      <section class="small-movil lss:normal-movil lg:normal-desktop sm:col-span-7 relative">
        <h2 class="subtitulo2-movil mt-4 mb-2 lg:mt-6 lg:subtitulo3-desktop">{te("cookie.3")}</h2>
        <p class="my-2">
            {te("cookie.4")}
        </p>

        <p class="my-2">
            {te("cookie.5")}
        </p>
        <p class="my-2">
            {te("cookie.6")}
        </p>
        <p class="my-2">
            {te("cookie.7")}
        </p>
      </section>

      <section class="small-movil lss:normal-movil lg:normal-desktop sm:col-span-7 relative">
        <h2 class="subtitulo2-movil mt-4 mb-2 lg:mt-6 lg:subtitulo3-desktop">{te("cookie.8")}</h2>
        <p class="my-2">
            {te("cookie.9")}
