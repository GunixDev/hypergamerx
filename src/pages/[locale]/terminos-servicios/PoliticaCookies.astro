            {t("article.articuclosreciente")}
        </h2>
        <div class="grid grid-cols-1 gap-2 sm:gap-3 lg:gap-4 mt-2 lg:mt-5">
          <!-- @formatter:off -->
            {
                allPosts.map((post) => {
                    const {slug, data} = post;
                    return <ArticulosRamdon file={slug} data={data} locale={lang}/>;
                })
